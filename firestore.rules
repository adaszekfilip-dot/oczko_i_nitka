rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.uid == "WKLEJ_TUTAJ_UID_ADMINA";
    }

    match /products/{productId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /orders/{orderId} {
      // Klient może złożyć zamówienie bez konta. Odczyt i zmiana tylko dla właścicielki.
      allow create: if
        request.resource.data.keys().hasAll([
          'customerName','customerEmail','message','items','total','status','createdAt'
        ])
        && request.resource.data.customerName is string
        && request.resource.data.customerName.size() > 0
        && request.resource.data.customerName.size() <= 100
        && request.resource.data.customerEmail is string
        && request.resource.data.customerEmail.size() <= 150
        && request.resource.data.message is string
        && request.resource.data.message.size() <= 1000
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0
        && request.resource.data.items.size() <= 30
        && request.resource.data.total is number
        && request.resource.data.total > 0
        && request.resource.data.status == "Nowe";
      allow read, update, delete: if isAdmin();
    }
  }
}
